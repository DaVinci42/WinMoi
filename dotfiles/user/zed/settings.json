{
  "auto_install_extensions": {
    "catppuccin": true
  },
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha"
  },
  "buffer_font_family": "JetBrainsMono NF",
  "terminal": {
    "font_family": "JetBrainsMono NF",
    "shell": {
      "with_arguments": {
        "program": "pwsh.exe",
        "args": ["-NoLogo"]
      }
    }
  }
}
