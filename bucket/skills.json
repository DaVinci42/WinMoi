{
    "version": "1.5.23",
    "description": "CLI for the open agent skills ecosystem.",
    "homepage": "https://skills.sh",
    "license": "MIT",
    "depends": "nodejs",
    "url": "https://registry.npmjs.org/skills/-/skills-1.5.23.tgz",
    "hash": "a4ddbadeedfd7aee5e1823c2037b0a313ce4017a8ff1f23b9f7fe30d52a1c963",
    "installer": {
        "script": [
            "Push-Location \"$dir\\package\"",
            "try { npm install --omit=dev --ignore-scripts --no-audit --no-fund } finally { Pop-Location }",
            "Set-Content -Path \"$dir\\skills.cmd\" -Value '@node \"%~dp0package\\bin\\cli.mjs\" %*' -Encoding ascii"
        ]
    },
    "bin": "skills.cmd",
    "checkver": {
        "url": "https://registry.npmjs.org/skills/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/skills/-/skills-$version.tgz"
    }
}
